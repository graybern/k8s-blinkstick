FROM python:3.12.13-alpine3.22 AS builder

RUN apk add --no-cache git gcc musl-dev libusb-dev

RUN pip install --no-cache-dir \
    git+https://github.com/arvydas/blinkstick-python.git@8140b9fa18a9ff4f0e9df8e70c073f41cb8f1d35 \
    pyusb==1.3.1 \
    paho-mqtt==2.1.0

RUN find /usr/local/lib/python3.12/site-packages -name 'blinkstick.py' \
    -exec sed -i 's/collections\.Callable/collections.abc.Callable/g' {} +

FROM python:3.12.13-alpine3.22

RUN apk add --no-cache libusb-dev

COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages

COPY agent/ /app/agent/

WORKDIR /app

CMD ["python", "-m", "agent.main"]
